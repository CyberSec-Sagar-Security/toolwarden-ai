# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets / credentials ---
.env
.env.*
*.key
*.pem
secrets.yaml
secrets.json
